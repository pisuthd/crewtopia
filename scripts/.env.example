# Copy to .env and fill in. NEVER commit this file.
NETWORK=bsc-testnet

# First run only: raw testnet key. The SDK encrypts it into
# ~/.bnbagent/wallets/<address>.json — then REMOVE this line.
PRIVATE_KEY=0x...

# Any string. Local keystore encryption only, never sent anywhere.
WALLET_PASSWORD=change-me

AGENT_NAME=swarmly-probe-01
AGENT_DESCRIPTION=Swarmly registration probe: throwaway test identity, not a real team.

# Team service (script 5). Port is derived from the base URL.
A2A_BASE_URL=http://localhost:8010
# Minimum budget this provider accepts, in raw payment-token units.
ERC8183_SERVICE_PRICE=1000000000000000000

# Voice probes (scripts/voice). Same values as backend-cdk/.env.
ELEVENLABS_API_KEY=
# LLM turn probe (2-turn.ts): same model the bots use.
PROVIDER_BASE_URL=
PROVIDER_MODEL=
PROVIDER_API_KEY=
